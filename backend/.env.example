# ============================================================
# RoomBuddy Backend — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed to git.

# ── Django ──
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── Database ──
DATABASE_URL=

# ── Redis ──
REDIS_URL=

# ── JWT ──
ACCESS_TOKEN_LIFETIME_MINUTES=
REFRESH_TOKEN_LIFETIME_DAYS=

# ── OTP ──
OTP_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_DEFAULT_FLOW_ID=

# ── CORS ──
CORS_ALLOWED_ORIGINS=

# ── Email ──
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Storage ──
STORAGE_PROVIDER=
S3_BUCKET_NAME=
S3_REGION=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ──
APP_BASE_URL=

# ── Razorpay ──
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Sentry (optional) ──
SENTRY_DSN=

# ── Notifications ──
SMS_PROVIDER=
SES_FROM_EMAIL=
AWS_SES_REGION=

# ── Google Maps / Geocoding ──
GEOCODING_URL=
GOOGLE_MAPS_BACKEND_API_KEY=

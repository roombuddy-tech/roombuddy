# ============================================================
# RoomBuddy Backend — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed to git.

# ── Django ──
DJANGO_SECRET_KEY=replace-with-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── Database ──
# Local: postgres://roombuddy:roombuddy@localhost:5432/roombuddy
# AWS:   postgres://USER:PASS@HOST.rds.amazonaws.com:5432/DB
# DATABASE_URL=postgres://roombuddy_admin:postgres123@roombuddy-db.abc123.ap-south-1.rds.amazonaws.com:5432/roombuddy

# ── Redis ──
# Local: redis://localhost:6379/0
# AWS:   rediss://HOST.cache.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
ACCESS_TOKEN_LIFETIME_MINUTES=10080
REFRESH_TOKEN_LIFETIME_DAYS=30

# ── OTP ──
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RMBDY

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Email ──
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RoomBuddy <no-reply@roombuddy.co.in>

# ── S3 (profile pictures — django-storages) ──
USE_S3=False
AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=

# ── Listing photo storage (custom storage.py) ──
# "local" = saves to backend/media/ (no AWS creds needed, good for local dev)
# "s3"    = uploads to S3 bucket (requires AWS credentials below)
STORAGE_PROVIDER=local
S3_BUCKET_NAME=
S3_REGION=ap-south-1

# ── AWS credentials (shared by profile-picture S3 and listing-photo S3) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ──
APP_BASE_URL=http://localhost:8000

# ── Razorpay ──
PAYMENT_PROVIDER=console
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Sentry (optional) ──
SENTRY_DSN=

# ── Production-only (set in /etc/roombuddy/env on EC2) ──
# ENVIRONMENT=production